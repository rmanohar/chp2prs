defenum op_t { 
  ADD, SUB, MULT, DIV
};

defproc src (chan!(int<8>) X1, X2; chan!(op_t) OP) {
  chp {
    *[ X1!6, X2!7, OP!op_t.MULT ]
  }
}

defproc alu (chan?(int<8>) X1, X2; chan?(op_t) OP; chan!(int<8>) Y) {
  int<8> x1, x2, y;
  op_t opcode;
  chp {
    *[ 
      X1?x1, X2?x2, OP?opcode;
      [ opcode = op_t.ADD  -> y := x1+x2
      []opcode = op_t.SUB  -> y := x1-x2
      []opcode = op_t.MULT -> y := x1*x2
      []opcode = op_t.DIV  -> y := x1/x2
      ];
      Y!y
    ]
  }
}

defproc snk (chan?(int<8>) Y) {
  int<8> y;
  chp {
    *[ Y?y ]
  }
}

defproc testproc (chan!(int<8>) Y) {
  src sr;
  snk sn;
  alu a (sr.X1, sr.X2, sr.OP, sn.Y);
  Y = sn.Y;
}